# Vercel runtime: a stable private key, at least 32 bytes. Generate with:
# openssl rand -hex 32
AGRIFORGE_SIGNING_KEY=

# Git-based Vercel builds: URL + SHA-256 of the minimal fixture archive.
# Create the archive with: npm run fixtures:pack
# Not needed for CLI uploads when the local data/five_points files are included.
AGRIFORGE_DATA_URL=
AGRIFORGE_DATA_SHA256=

# Optional rehearsal only; live queries are the default.
# AGRIFORGE_OFFLINE=1
