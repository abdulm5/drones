# Vercel runtime: a stable private key, at least 32 bytes. Generate with:
# openssl rand -hex 32
AGRIFORGE_SIGNING_KEY=

# Optional override. Git builds automatically use the checksum-pinned release
# archive in scripts/deployment-fixtures.json when local fixtures are missing.
# Set BOTH values only when supplying your own archive.
AGRIFORGE_DATA_URL=
AGRIFORGE_DATA_SHA256=

# Optional rehearsal only; live queries are the default.
# AGRIFORGE_OFFLINE=1

# Server-side xAI key for the consultant. Never prefix with VITE_.
XAI_API_KEY=
XAI_MODEL=grok-4
